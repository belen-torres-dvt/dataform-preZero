config {
  type: "assertion",
  schema: constants.SCHEMAS.ASSERTIONS,
  //tags: ["proceso_prestaff", "prestaff", "assertions"],
  description: "Calidad PreStaff: Comprueba que ningún registro contenga FTEs negativos"
}

SELECT
  prestaff_sk,
  numero_personal,
  year,
  month,
  ftes_dia,
  ftes_mes,
  nombre_fichero,
  _source_file_id
FROM
  ${ref("slv_prestaff")}
WHERE
  ftes_dia < 0 OR ftes_mes < 0 OR ftes_ano < 0
