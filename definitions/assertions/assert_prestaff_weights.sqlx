config {
  type: "assertion",
  schema: constants.SCHEMAS.ASSERTIONS,
  //tags: ["prestaff", "assertions"],
  description: "Calidad PreStaff: Comprueba que ningún pesaje contenga pesos netos negativos"
}

SELECT
  prestaff_sk,
  id_registro,
  peso_neto_kg,
  _source_file_id
FROM
  ${ref("slv_prestaff")}
WHERE
  peso_neto_kg < 0
