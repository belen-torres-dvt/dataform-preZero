config {
  type: "assertion",
  schema: constants.SCHEMAS.ASSERTIONS,
  tags: ["medioambiente", "assertions"],
  description: "Calidad Medioambiente: Valida que costes, CO2 e índice de impacto ambiental tengan valores coherentes"
}

SELECT
  proyecto_sk,
  id_proyecto,
  coste_implementacion_eur,
  reduccion_co2_ton_ano,
  indice_impacto_ambiental_1_10,
  _source_file_id
FROM
  ${ref("slv_medioambiente")}
WHERE
  coste_implementacion_eur < 0
  OR reduccion_co2_ton_ano < 0
  OR (indice_impacto_ambiental_1_10 IS NOT NULL AND (indice_impacto_ambiental_1_10 < 1 OR indice_impacto_ambiental_1_10 > 10))
