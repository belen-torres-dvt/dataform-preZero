config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.RAW,
  name: "drive_source_prezero",
  tags: ["prezero", "source"],
  description: "Crea tablas externas BigQuery para los CSVs de PreZero y las materializa en una tabla nativa"
}

js {
  const files = helpers.getFilesForTag("prezero");
}

-- Crear una tabla externa en bq_drive_euw1 para cada fichero CSV que coincide con 'prezero'
${files.map((file, idx) => `
  CREATE OR REPLACE EXTERNAL TABLE \`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.RAW}.ext_prezero_${idx}\`
  OPTIONS (
    format = "CSV",
    uris = ["https://drive.google.com/open?id=${file.id}"],
    skip_leading_rows = 1
  );
`).join("\n")}

-- Eliminar la vista previa si existía para permitir crear la tabla nativa sin conflictos de tipo
DROP VIEW IF EXISTS ${self()};

-- Materializar los CSVs de Drive en una tabla nativa BigQuery para acelerar lecturas downstream (Bronze y Silver)
CREATE OR REPLACE TABLE ${self()} AS
${files.length > 0 ? files.map((file, idx) => `
  SELECT
    *,
    '${file.id}' AS file_id,
    '${file.name}' AS file_name,
    '${file.id}' AS _source_file_id,
    '${file.name}' AS _source_file_name
  FROM \`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.RAW}.ext_prezero_${idx}\`
`).join("\nUNION ALL\n") : `
  SELECT
    CAST(NULL AS STRING) AS id_registro,
    CAST(NULL AS STRING) AS centro_operativo,
    CAST(NULL AS STRING) AS tipo_residuo,
    CAST(NULL AS STRING) AS peso_neto_kg,
    CAST(NULL AS STRING) AS fecha_operacion,
    CAST(NULL AS STRING) AS fecha_hora_pesaje,
    'placeholder_id' AS file_id,
    'placeholder_name' AS file_name,
    'placeholder_id' AS _source_file_id,
    'placeholder_name' AS _source_file_name
  FROM (SELECT 1)
  WHERE FALSE
`};

-- Limpiar tablas externas temporales tras materializar los datos en la tabla nativa
${files.map((file, idx) => `
  DROP TABLE IF EXISTS \`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.RAW}.ext_prezero_${idx}\`;
`).join("\n")}
