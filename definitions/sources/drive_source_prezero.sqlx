config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.RAW,
  name: "drive_source_prezero",
  tags: ["prezero", "source"],
  description: "Crea tablas externas BigQuery para los CSVs de PreZero y las unifica en una vista única"
}

js {
  const files = helpers.getFilesForTag("prezero");
}

-- Crear una tabla externa en bq_stg_euw1 para cada fichero CSV que coincide con 'prezero'
${files.map((file, idx) => `
  CREATE OR REPLACE EXTERNAL TABLE \`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.RAW}.ext_prezero_${idx}\`
  OPTIONS (
    format = "CSV",
    uris = ["https://drive.google.com/open?id=${file.id}"],
    autodetect = TRUE,
    skip_leading_rows = 1
  );
`).join("\n")}

-- Vista unificada de los CSVs de PreZero con trazabilidad del fichero de origen
CREATE OR REPLACE VIEW ${self()} AS
${files.length > 0 ? files.map((file, idx) => `
  SELECT
    *,
    '${file.id}' AS _source_file_id,
    '${file.name}' AS _source_file_name
  FROM \`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.RAW}.ext_prezero_${idx}\`
`).join("\nUNION ALL\n") : `
  SELECT
    CAST(NULL AS STRING) AS id_registro,
    CAST(NULL AS STRING) AS centro_operativo,
    CAST(NULL AS STRING) AS tipo_residuo,
    CAST(NULL AS NUMERIC) AS peso_neto_kg,
    CAST(NULL AS DATE) AS fecha_operacion,
    CAST(NULL AS TIMESTAMP) AS fecha_hora_pesaje,
    'placeholder_id' AS _source_file_id,
    'placeholder_name' AS _source_file_name
  WHERE FALSE
`};
