config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.RAW,
  name: "drive_source_prestaff",
  tags: ["prestaff", "source"],
  description: "Tablas externas BigQuery en bq_drive_euw1 apuntando a los CSVs mensuales de PreStaff en Google Drive"
}

js {
  const files = helpers.getFilesForTag("prestaff");
}

-- 1. Crear tablas externas en bq_drive_euw1 por cada fichero mensual prestaff_[añomes]
${files.length > 0 ? files.map((file, idx) => `
  CREATE OR REPLACE EXTERNAL TABLE ${idx === 0 ? self() : `\`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.RAW}.ext_prestaff_${helpers.getFileMonthSuffix(file.name, idx)}\``}
  OPTIONS (
    format = "CSV",
    uris = ["https://drive.google.com/open?id=${file.id}"],
    skip_leading_rows = 1,
    field_delimiter = "${dataform.projectConfig.vars.field_delimiter || ";"}",
    ignore_unknown_values = true,
    allow_jagged_rows = true,
    allow_quoted_newlines = true
  );
`).join("\n") : `
  SELECT 1;
`}

