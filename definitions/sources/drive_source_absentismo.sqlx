config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.RAW,
  name: "drive_source_absentismo",
  tags: ["absentismo", "source"],
  description: "Tabla externa BigQuery en bq_drive_euw1 apuntando a los datos de Absentismo en Google Drive"
}

js {
  const files = helpers.getFilesForTag("absentismo");
}

-- 1. Crear directamente la tabla externa en bq_drive_euw1
${files.length > 0 ? files.map((file, idx) => `
  CREATE OR REPLACE EXTERNAL TABLE ${idx === 0 ? self() : `${constants.SCHEMAS.RAW}.ext_absentismo_${idx}`}
  OPTIONS (
    format = "CSV",
    uris = ["https://drive.google.com/open?id=${file.id}"],
    skip_leading_rows = 1,
    ignore_unknown_values = true,
    allow_jagged_rows = true,
    allow_quoted_newlines = true
  );
`).join("\n") : `
  SELECT 1;
`}
