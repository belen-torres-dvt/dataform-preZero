config {
  type: "table",
  schema: constants.SCHEMAS.BRONZE,
  tags: ["prezero", "bronze"],
  description: "Capa Bronze: Tipado inicial y saneamiento de registros de pesajes y operaciones PreZero (Tabla Nativa)",
  bigquery: {
    clusterBy: ["file_name"]
  },
  columns: {
    id_registro: "Identificador del registro de pesaje u operación",
    centro_operativo: "Nombre o código de la planta / centro operativo",
    tipo_residuo: "Fracción o tipología de material / residuo",
    peso_neto_kg: "Peso neto en kilogramos registrado en báscula",
    fecha_operacion: "Fecha de la operación de pesaje",
    fecha_hora_pesaje: "Timestamp exacto del evento de pesaje",
    file_id: docs.columns.file_id,
    file_name: docs.columns.file_name,
    _source_file_id: docs.columns._source_file_id,
    _source_file_name: docs.columns._source_file_name,
    _dw_loaded_at: docs.columns._dw_loaded_at,
    _dw_loaded_by: docs.columns._dw_loaded_by
  }
}

js {
  const files = helpers.getFilesForTag("prezero");

  function selectFromExternal(tableRef, file) {
    const fId = file ? file.id : "";
    const fName = file ? file.name : "";
    return `
      SELECT
        ${helpers.cleanString("id_registro")} AS id_registro,
        UPPER(COALESCE(${helpers.cleanString("centro_operativo")}, "CENTRO_GENERAL")) AS centro_operativo,
        UPPER(COALESCE(${helpers.cleanString("tipo_residuo")}, "GENERAL")) AS tipo_residuo,
        SAFE_CAST(peso_neto_kg AS NUMERIC) AS peso_neto_kg,
        COALESCE(SAFE_CAST(fecha_operacion AS DATE), CURRENT_DATE()) AS fecha_operacion,
        SAFE_CAST(fecha_hora_pesaje AS TIMESTAMP) AS fecha_hora_pesaje,
        '${fId}' AS file_id,
        '${fName}' AS file_name,
        '${fId}' AS _source_file_id,
        '${fName}' AS _source_file_name,
        CURRENT_TIMESTAMP() AS _dw_loaded_at,
        SESSION_USER() AS _dw_loaded_by
      FROM
        ${tableRef}
      WHERE
        ${helpers.cleanString("id_registro")} IS NOT NULL
    `;
  }
}

pre_operations {
  BEGIN
    DECLARE obj_type STRING;
    SET obj_type = (
      SELECT table_type 
      FROM ${constants.SCHEMAS.BRONZE}.INFORMATION_SCHEMA.TABLES
      WHERE table_name = '${self().name}'
    );
    IF obj_type = 'VIEW' THEN
      DROP VIEW IF EXISTS ${self()};
    END IF;
  EXCEPTION WHEN ERROR THEN
    NULL;
  END;
}

${files.length <= 1 ? selectFromExternal(ref("drive_source_prezero"), files[0]) :
  files.map((file, idx) => selectFromExternal(
    idx === 0 ? ref("drive_source_prezero") : `${constants.SCHEMAS.RAW}.ext_prezero_${idx}`,
    file
  )).join("\nUNION ALL\n")
}
