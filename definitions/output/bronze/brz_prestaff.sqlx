config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.BRONZE,
  name: "brz_prestaff",
  dependencies: ["drive_source_prestaff"],
  tags: ["prestaff", "bronze"],
  description: "Capa Bronze: Tablas nativas 1:1 en BigQuery por cada fichero mensual de PreStaff (sin transformaciones ni unions)"
}

js {
  const files = helpers.getFilesForTag("prestaff");
}

-- 1. Crear tablas nativas 1:1 en Bronze por cada fichero mensual de PreStaff (sin UNION ni transformaciones)
${files.length > 0 ? files.map((file, idx) => {
  const suffix = helpers.getFileMonthSuffix(file.name, idx);
  const extTable = `\`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.RAW}.drive_source_prestaff_${suffix}\``;
  const brzTable = `\`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.BRONZE}.brz_prestaff_${suffix}\``;
  return `
    CREATE OR REPLACE TABLE ${brzTable} AS
    SELECT
      *,
      ${helpers.auditColumns("prestaff")}
    FROM
      ${extTable};
  `;
}).join("\n") : `
  SELECT 1;
`}

-- 2. Mantener la tabla principal brz_prestaff (${self()}) sincronizada con el fichero actual
${files.length > 0 ? `
  CREATE OR REPLACE TABLE ${self()} AS
  SELECT * FROM \`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.BRONZE}.brz_prestaff_${helpers.getFileMonthSuffix(files[0].name, 0)}\`;
` : ""}

