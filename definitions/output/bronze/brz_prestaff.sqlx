config {
  type: "operations",
  hasOutput: true,
  schema: constants.SCHEMAS.BRONZE,
  name: "brz_prestaff",
  dependencies: ["drive_source_prestaff"],
  tags: ["proceso_prestaff", "prestaff", "bronze"],
  description: "Capa Bronze: Tablas nativas 1:1 en BigQuery por cada fichero mensual de PreStaff con sufijo y nombre_fichero (sin transformaciones ni unions)"
}

js {
  const files = helpers.getFilesForTag("prestaff");
}

-- 1. Crear tablas nativas 1:1 en Bronze por cada fichero mensual de PreStaff (con sufijo brz_prestaff_{sufijoFichero}, sin UNION ni transformaciones)
${files.length > 0 ? files.map((file, idx) => {
  const suffix = helpers.getFileMonthSuffix(file.name, idx);
  const extTable = `\`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.RAW}.drive_source_prestaff_${suffix}\``;
  const brzTable = `\`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.BRONZE}.brz_prestaff_${suffix}\``;
  return `
    CREATE OR REPLACE EXTERNAL TABLE ${extTable}
    OPTIONS (
      format = "CSV",
      uris = ["https://drive.google.com/open?id=${file.id}"],
      skip_leading_rows = 1,
      field_delimiter = "${dataform.projectConfig.vars.field_delimiter || ";"}",
      ignore_unknown_values = true,
      allow_jagged_rows = true,
      allow_quoted_newlines = true
    );

    CREATE OR REPLACE TABLE ${brzTable} AS
    SELECT
      *,
      '${suffix}' AS nombre_fichero,
      '${file.id}' AS file_id,
      '${file.name}' AS file_name,
      '${file.id}' AS _source_file_id,
      '${file.name}' AS _source_file_name,
      CURRENT_TIMESTAMP() AS _dw_loaded_at,
      SESSION_USER() AS _dw_loaded_by
    FROM
      ${extTable};
  `;
}).join("\n") : `
  SELECT 1;
`}
