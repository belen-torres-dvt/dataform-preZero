config {
  type: "table",
  schema: constants.SCHEMAS.BRONZE,
  tags: ["absentismo", "bronze"],
  description: "Capa Bronze: Ingesta en bruto de datos de absentismo en tabla nativa BigQuery",
  bigquery: {
    clusterBy: ["file_name"]
  }
}

js {
  const files = helpers.getFilesForTag("absentismo");

  function selectRawFromExternal(tableRef, file) {
    const fId = file ? file.id : "";
    const fName = file ? file.name : "";
    return `
      SELECT
        *,
        '${fId}' AS file_id,
        '${fName}' AS file_name,
        '${fId}' AS _source_file_id,
        '${fName}' AS _source_file_name,
        CURRENT_TIMESTAMP() AS _dw_loaded_at,
        SESSION_USER() AS _dw_loaded_by
      FROM
        ${tableRef}
    `;
  }
}


${files.length <= 1 ? selectRawFromExternal(ref("drive_source_absentismo"), files[0]) :
  files.map((file, idx) => selectRawFromExternal(
    idx === 0 ? ref("drive_source_absentismo") : `${constants.SCHEMAS.RAW}.ext_absentismo_${idx}`,
    file
  )).join("\nUNION ALL\n")
}
