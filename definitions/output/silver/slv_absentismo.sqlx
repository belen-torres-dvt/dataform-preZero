config {
  type: "incremental",
  schema: constants.SCHEMAS.SILVER,
  dependencies: ["brz_absentismo"],
  tags: ["proceso_prestaff", "absentismo", "silver"],
  description: "Capa Silver: Bajas y ausencias de personal consolidadas, tipadas, deduplicadas y con surrogate key (Histórico)",
  bigquery: {
    clusterBy: ["file_name"]
  },
  columns: {
    absentismo_sk: "Surrogate Key determinista SHA256 (id_empleado + fecha_inicio + motivo_baja)",
    id_empleado: "Identificador del empleado",
    departamento: "Departamento organizacional",
    motivo_baja: "Causa o motivo de la ausencia",
    dias_ausencia: "Total de días computados de baja",
    horas_ausencia: "Total de horas de ausencia laboral",
    fecha_inicio: "Fecha de inicio de la baja",
    fecha_fin: "Fecha de finalización de la baja",
    file_id: docs.columns.file_id,
    file_name: docs.columns.file_name,
    _source_file_id: docs.columns._source_file_id,
    _source_file_name: docs.columns._source_file_name,
    _dw_loaded_at: docs.columns._dw_loaded_at,
    _dw_loaded_by: docs.columns._dw_loaded_by
  }
}

js {
  const files = helpers.getFilesForTag("absentismo");

  function getAbsentismoSource() {
    if (files.length === 0) {
      return "SELECT " +
        "CAST(NULL AS STRING) AS id_empleado, " +
        "CAST(NULL AS STRING) AS departamento, " +
        "CAST(NULL AS STRING) AS motivo_baja, " +
        "CAST(NULL AS NUMERIC) AS dias_ausencia, " +
        "CAST(NULL AS NUMERIC) AS horas_ausencia, " +
        "CAST(NULL AS DATE) AS fecha_inicio, " +
        "CAST(NULL AS DATE) AS fecha_fin, " +
        "CAST(NULL AS STRING) AS file_id, " +
        "CAST(NULL AS STRING) AS file_name, " +
        "CAST(NULL AS STRING) AS _source_file_id, " +
        "CAST(NULL AS STRING) AS _source_file_name, " +
        "CAST(NULL AS TIMESTAMP) AS _dw_loaded_at, " +
        "CAST(NULL AS STRING) AS _dw_loaded_by " +
        "WHERE FALSE";
    }
    return "`" + dataform.projectConfig.defaultDatabase + "." + constants.SCHEMAS.BRONZE + ".brz_absentismo`";
  }
}

SELECT
  ${helpers.surrogateKey(["id_empleado", "fecha_inicio", "motivo_baja"])} AS absentismo_sk,
  ${helpers.cleanString("id_empleado")} AS id_empleado,
  UPPER(COALESCE(${helpers.cleanString("departamento")}, "NO_ASIGNADO")) AS departamento,
  UPPER(COALESCE(${helpers.cleanString("motivo_baja")}, "NO_ESPECIFICADO")) AS motivo_baja,
  COALESCE(SAFE_CAST(dias_ausencia AS NUMERIC), 0) AS dias_ausencia,
  COALESCE(SAFE_CAST(horas_ausencia AS NUMERIC), SAFE_CAST(dias_ausencia AS NUMERIC) * 8, 0) AS horas_ausencia,
  SAFE_CAST(fecha_inicio AS DATE) AS fecha_inicio,
  SAFE_CAST(fecha_fin AS DATE) AS fecha_fin,
  file_id,
  file_name,
  _source_file_id,
  _source_file_name,
  CURRENT_TIMESTAMP() AS _dw_loaded_at,
  SESSION_USER() AS _dw_loaded_by
FROM
  (${getAbsentismoSource()})
WHERE
  ${helpers.cleanString("id_empleado")} IS NOT NULL
  ${when(incremental() && helpers.hasFilesForTag("absentismo"), `AND file_name IN (${helpers.getFileNamesSqlList("absentismo")})`)}
  ${when(incremental() && !helpers.hasFilesForTag("absentismo"), `AND FALSE`)}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY id_empleado, fecha_inicio, motivo_baja 
  ORDER BY _dw_loaded_at DESC
) = 1
