config {
  type: "incremental",
  schema: constants.SCHEMAS.SILVER,
  dependencies: ["brz_medioambiente"],
  tags: ["proceso_prestaff", "medioambiente", "silver"],
  description: "Capa Silver: Proyectos de soluciones medioambientales consolidados, tipados, deduplicados y con clave subrogada (Histórico)",
  bigquery: {
    clusterBy: ["file_name"]
  },
  columns: {
    proyecto_sk: "Surrogate Key determinista SHA256 (nombre_solucion + fecha_registro + empresa_proveedora + pais)",
    fecha_registro: "Fecha de registro del proyecto",
    nombre_solucion: "Título o descripción de la solución",
    categoria_solucion: "Categoría de la solución implementada",
    pais: "País de ejecución del proyecto",
    region_geografica: "Región geográfica del proyecto",
    empresa_proveedora: "Empresa tecnológica o proveedora de la solución",
    sector_cliente: "Sector económico del cliente final",
    coste_implementacion_eur: "Coste de implantación en Euros",
    ahorro_anual_estimado_eur: "Ahorro anual proyectado en Euros",
    reduccion_co2_ton_ano: "Toneladas de CO2 reducidas anualmente",
    volumen_agua_reciclada_m3: "Metros cúbicos de agua reciclada",
    energia_renovable_generada_mwh: "Megavatios hora generados de origen renovable",
    residuos_desviados_vertedero_ton: "Toneladas de residuos desviados de vertedero",
    estado_proyecto: "Estado del proyecto",
    certificacion_ambiental: "Estándar o certificación ambiental",
    huella_carbono_inicial_ton: "Huella de carbono previa en toneladas",
    roi_estimado_anos: "Plazo estimado de recuperación de la inversión (años)",
    subvencion_publica_porc: "Porcentaje de subvención pública sobre el coste",
    indice_impacto_ambiental_1_10: "Índice de impacto ambiental (escala 1 a 10)",
    file_id: docs.columns.file_id,
    file_name: docs.columns.file_name,
    _source_file_id: docs.columns._source_file_id,
    _source_file_name: docs.columns._source_file_name,
    _dw_loaded_at: docs.columns._dw_loaded_at,
    _dw_loaded_by: docs.columns._dw_loaded_by
  }
}

js {
  const files = helpers.getFilesForTag("medioambiente");

  function getMedioambienteSource() {
    if (files.length === 0) {
      return "SELECT " +
        "CAST(NULL AS DATE) AS fecha_registro, " +
        "CAST(NULL AS STRING) AS nombre_solucion, " +
        "CAST(NULL AS STRING) AS categoria_solucion, " +
        "CAST(NULL AS STRING) AS pais, " +
        "CAST(NULL AS STRING) AS region_geografica, " +
        "CAST(NULL AS STRING) AS empresa_proveedora, " +
        "CAST(NULL AS STRING) AS sector_cliente, " +
        "CAST(NULL AS NUMERIC) AS coste_implementacion_eur, " +
        "CAST(NULL AS NUMERIC) AS ahorro_anual_estimado_eur, " +
        "CAST(NULL AS NUMERIC) AS reduccion_co2_ton_ano, " +
        "CAST(NULL AS NUMERIC) AS volumen_agua_reciclada_m3, " +
        "CAST(NULL AS NUMERIC) AS energia_renovable_generada_mwh, " +
        "CAST(NULL AS NUMERIC) AS residuos_desviados_vertedero_ton, " +
        "CAST(NULL AS STRING) AS estado_proyecto, " +
        "CAST(NULL AS STRING) AS certificacion_ambiental, " +
        "CAST(NULL AS NUMERIC) AS huella_carbono_inicial_ton, " +
        "CAST(NULL AS NUMERIC) AS roi_estimado_anos, " +
        "CAST(NULL AS NUMERIC) AS subvencion_publica_porc, " +
        "CAST(NULL AS NUMERIC) AS indice_impacto_ambiental_1_10, " +
        "CAST(NULL AS STRING) AS file_id, " +
        "CAST(NULL AS STRING) AS file_name, " +
        "CAST(NULL AS STRING) AS _source_file_id, " +
        "CAST(NULL AS STRING) AS _source_file_name, " +
        "CAST(NULL AS TIMESTAMP) AS _dw_loaded_at, " +
        "CAST(NULL AS STRING) AS _dw_loaded_by " +
        "WHERE FALSE";
    }
    return "`" + dataform.projectConfig.defaultDatabase + "." + constants.SCHEMAS.BRONZE + ".brz_medioambiente`";
  }
}

SELECT
  ${helpers.surrogateKey(["nombre_solucion", "fecha_registro", "empresa_proveedora", "pais"])} AS proyecto_sk,
  SAFE_CAST(fecha_registro AS DATE) AS fecha_registro,
  ${helpers.cleanString("nombre_solucion")} AS nombre_solucion,
  UPPER(${helpers.cleanString("categoria_solucion")}) AS categoria_solucion,
  ${helpers.cleanString("pais")} AS pais,
  ${helpers.cleanString("region_geografica")} AS region_geografica,
  ${helpers.cleanString("empresa_proveedora")} AS empresa_proveedora,
  ${helpers.cleanString("sector_cliente")} AS sector_cliente,
  COALESCE(SAFE_CAST(coste_implementacion_eur AS NUMERIC), 0) AS coste_implementacion_eur,
  COALESCE(SAFE_CAST(ahorro_anual_estimado_eur AS NUMERIC), 0) AS ahorro_anual_estimado_eur,
  COALESCE(SAFE_CAST(reduccion_co2_ton_ano AS NUMERIC), 0) AS reduccion_co2_ton_ano,
  COALESCE(SAFE_CAST(volumen_agua_reciclada_m3 AS NUMERIC), 0) AS volumen_agua_reciclada_m3,
  COALESCE(SAFE_CAST(energia_renovable_generada_mwh AS NUMERIC), 0) AS energia_renovable_generada_mwh,
  COALESCE(SAFE_CAST(residuos_desviados_vertedero_ton AS NUMERIC), 0) AS residuos_desviados_vertedero_ton,
  UPPER(${helpers.cleanString("estado_proyecto")}) AS estado_proyecto,
  ${helpers.cleanString("certificacion_ambiental")} AS certificacion_ambiental,
  SAFE_CAST(huella_carbono_inicial_ton AS NUMERIC) AS huella_carbono_inicial_ton,
  SAFE_CAST(roi_estimado_anos AS NUMERIC) AS roi_estimado_anos,
  SAFE_CAST(subvencion_publica_porc AS NUMERIC) AS subvencion_publica_porc,
  SAFE_CAST(indice_impacto_ambiental_1_10 AS NUMERIC) AS indice_impacto_ambiental_1_10,
  file_id,
  file_name,
  _source_file_id,
  _source_file_name,
  CURRENT_TIMESTAMP() AS _dw_loaded_at,
  SESSION_USER() AS _dw_loaded_by
FROM
  (${getMedioambienteSource()})
WHERE
  ${helpers.cleanString("nombre_solucion")} IS NOT NULL
  ${when(incremental() && helpers.hasFilesForTag("medioambiente"), `AND file_name IN (${helpers.getFileNamesSqlList("medioambiente")})`)}
  ${when(incremental() && !helpers.hasFilesForTag("medioambiente"), `AND FALSE`)}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY nombre_solucion, fecha_registro, empresa_proveedora, pais
  ORDER BY _dw_loaded_at DESC
) = 1
