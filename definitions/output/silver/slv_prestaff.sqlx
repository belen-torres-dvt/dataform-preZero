config {
  type: "incremental",
  schema: constants.SCHEMAS.SILVER,
  dependencies: ["brz_prestaff"],
  tags: ["proceso_prestaff"],
  description: "Capa Silver: Registros de PreStaff unificados por UNION ALL, tipados, deduplicados y con partición por nombre_fichero",
  bigquery: {
    clusterBy: ["nombre_fichero", "numero_personal"]
  },
  columns: {
    prestaff_sk: "Surrogate Key determinista SHA256 (numero_personal + Year + Month + codigo_absentismo + Contrato + nombre_fichero)",
    nombre_fichero: "Sufijo/identificador del fichero mensual (ej: 202607) para eliminación y recarga idempotente sin duplicados",
    year: "Año del registro",
    month: "Mes del registro",
    division: "División de la organización",
    numero_personal: "Identificador del empleado (Número de Personal)",
    categoria_profesional: "Categoría profesional asignada",
    agrupador: "Agrupador del registro",
    codigo_absentismo: "Código de absentismo",
    descripcion: "Descripción del absentismo",
    contrato: "Tipo o código de contrato",
    ftes_dia: "FTEs diarios",
    divisor_mes: "Divisor mensual",
    ftes_mes: "FTEs mensuales",
    divisor_ano: "Divisor anual",
    ftes_ano: "FTEs anuales",
    file_id: docs.columns.file_id,
    file_name: docs.columns.file_name,
    _source_file_id: docs.columns._source_file_id,
    _source_file_name: docs.columns._source_file_name,
    _dw_loaded_at: docs.columns._dw_loaded_at,
    _dw_loaded_by: docs.columns._dw_loaded_by
  }
}

pre_operations {
  ${when(incremental() && helpers.hasFilesForTag("prestaff"), `
    DELETE FROM ${self()}
    WHERE nombre_fichero IN (${helpers.getSuffixesSqlList("prestaff")})
  `)}
}

js {
  const files = helpers.getFilesForTag("prestaff");

  function getBronzeSources() {
    if (files.length === 0) {
      return "SELECT " +
        "CAST(NULL AS STRING) AS Year, " +
        "CAST(NULL AS STRING) AS Month, " +
        "CAST(NULL AS STRING) AS Divisi__n, " +
        "CAST(NULL AS STRING) AS N__mero_de_Personal, " +
        "CAST(NULL AS STRING) AS Categor__a_profesional, " +
        "CAST(NULL AS STRING) AS Agrupador, " +
        "CAST(NULL AS STRING) AS C__digo_Absentismo, " +
        "CAST(NULL AS STRING) AS descripci__n, " +
        "CAST(NULL AS STRING) AS Contrato, " +
        "CAST(NULL AS STRING) AS ftes_dia, " +
        "CAST(NULL AS STRING) AS divisor_mes, " +
        "CAST(NULL AS STRING) AS Ftes_mes, " +
        "CAST(NULL AS STRING) AS divisor_a__o, " +
        "CAST(NULL AS STRING) AS Ftes_a__o, " +
        "CAST(NULL AS STRING) AS nombre_fichero, " +
        "CAST(NULL AS STRING) AS file_id, " +
        "CAST(NULL AS STRING) AS file_name, " +
        "CAST(NULL AS STRING) AS _source_file_id, " +
        "CAST(NULL AS STRING) AS _source_file_name, " +
        "CAST(NULL AS TIMESTAMP) AS _dw_loaded_at, " +
        "CAST(NULL AS STRING) AS _dw_loaded_by " +
        "WHERE FALSE";
    }
    return files.map((file, idx) => {
      const suffix = helpers.getFileMonthSuffix(file.name, idx);
      const tableRef = "`" + dataform.projectConfig.defaultDatabase + "." + constants.SCHEMAS.BRONZE + ".brz_prestaff_" + suffix + "`";
      return "SELECT * FROM " + tableRef;
    }).join("\n  UNION ALL\n  ");
  }
}

SELECT
  ${helpers.surrogateKey(["N__mero_de_Personal", "Year", "Month", "COALESCE(C__digo_Absentismo, '_na_')", "COALESCE(Contrato, '_na_')", "nombre_fichero"])} AS prestaff_sk,
  nombre_fichero,
  SAFE_CAST(Year AS INT64) AS year,
  SAFE_CAST(Month AS INT64) AS month,
  ${helpers.cleanString("Divisi__n")} AS division,
  ${helpers.cleanString("N__mero_de_Personal")} AS numero_personal,
  ${helpers.cleanString("Categor__a_profesional")} AS categoria_profesional,
  ${helpers.cleanString("Agrupador")} AS agrupador,
  ${helpers.cleanString("C__digo_Absentismo")} AS codigo_absentismo,
  ${helpers.cleanString("descripci__n")} AS descripcion,
  ${helpers.cleanString("Contrato")} AS contrato,
  COALESCE(SAFE_CAST(REPLACE(CAST(ftes_dia AS STRING), ',', '.') AS NUMERIC), 0) AS ftes_dia,
  COALESCE(SAFE_CAST(REPLACE(CAST(divisor_mes AS STRING), ',', '.') AS NUMERIC), 0) AS divisor_mes,
  COALESCE(SAFE_CAST(REPLACE(CAST(Ftes_mes AS STRING), ',', '.') AS NUMERIC), 0) AS ftes_mes,
  COALESCE(SAFE_CAST(REPLACE(CAST(divisor_a__o AS STRING), ',', '.') AS NUMERIC), 0) AS divisor_ano,
  COALESCE(SAFE_CAST(REPLACE(CAST(Ftes_a__o AS STRING), ',', '.') AS NUMERIC), 0) AS ftes_ano,
  file_id,
  file_name,
  _source_file_id,
  _source_file_name,
  CURRENT_TIMESTAMP() AS _dw_loaded_at,
  SESSION_USER() AS _dw_loaded_by
FROM (
  ${getBronzeSources()}
)
WHERE
  ${helpers.cleanString("N__mero_de_Personal")} IS NOT NULL
  ${when(incremental() && helpers.hasFilesForTag("prestaff"), `AND nombre_fichero IN (${helpers.getSuffixesSqlList("prestaff")})`)}
  ${when(incremental() && !helpers.hasFilesForTag("prestaff"), `AND FALSE`)}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY 
    N__mero_de_Personal, 
    Year, 
    Month, 
    COALESCE(C__digo_Absentismo, ''), 
    COALESCE(Contrato, ''), 
    nombre_fichero
  ORDER BY _dw_loaded_at DESC
) = 1
