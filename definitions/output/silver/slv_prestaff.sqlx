config {
  type: "incremental",
  schema: constants.SCHEMAS.SILVER,
  tags: ["prestaff", "silver"],
  description: "Capa Silver: Registros de PreStaff limpios, tipados, deduplicados y con surrogate key determinista (Histórico)",
  bigquery: {
    clusterBy: ["file_name"]
  },
  columns: {
    prestaff_sk: "Surrogate Key determinista SHA256 (id_registro + fecha_operacion)",
    id_registro: "Identificador del registro de pesaje",
    centro_operativo: "Centro o planta operativa estandarizada",
    tipo_residuo: "Tipología de material estandarizada",
    peso_neto_kg: "Peso neto en kilogramos verificado",
    fecha_operacion: "Fecha de la operación",
    fecha_hora_pesaje: "Timestamp del pesaje",
    file_id: docs.columns.file_id,
    file_name: docs.columns.file_name,
    _source_file_id: docs.columns._source_file_id,
    _source_file_name: docs.columns._source_file_name,
    _dw_loaded_at: docs.columns._dw_loaded_at,
    _dw_loaded_by: docs.columns._dw_loaded_by
  },
  assertions: {
    uniqueKey: ["prestaff_sk"],
    nonNull: ["prestaff_sk", "id_registro"]
  }
}


js {
  const files = helpers.getFilesForTag("prestaff");

  function getBronzeSources() {
    if (files.length <= 1) {
      return `SELECT * FROM ${ref("brz_prestaff")}`;
    }
    return files.map((file, idx) => {
      const suffix = helpers.getFileMonthSuffix(file.name, idx);
      const tableRef = idx === 0
        ? ref("brz_prestaff")
        : `\`${dataform.projectConfig.defaultDatabase}.${constants.SCHEMAS.BRONZE}.brz_prestaff_${suffix}\``;
      return `SELECT * FROM ${tableRef}`;
    }).join("\n  UNION ALL\n  ");
  }
}

SELECT
  ${helpers.surrogateKey(["id_registro", "fecha_operacion"])} AS prestaff_sk,
  ${helpers.cleanString("id_registro")} AS id_registro,
  UPPER(COALESCE(${helpers.cleanString("centro_operativo")}, "CENTRO_GENERAL")) AS centro_operativo,
  UPPER(COALESCE(${helpers.cleanString("tipo_residuo")}, "GENERAL")) AS tipo_residuo,
  COALESCE(SAFE_CAST(peso_neto_kg AS NUMERIC), 0) AS peso_neto_kg,
  COALESCE(SAFE_CAST(fecha_operacion AS DATE), CURRENT_DATE()) AS fecha_operacion,
  SAFE_CAST(fecha_hora_pesaje AS TIMESTAMP) AS fecha_hora_pesaje,
  file_id,
  file_name,
  _source_file_id,
  _source_file_name,
  CURRENT_TIMESTAMP() AS _dw_loaded_at,
  SESSION_USER() AS _dw_loaded_by
FROM (
  ${getBronzeSources()}
)
WHERE
  ${helpers.cleanString("id_registro")} IS NOT NULL
  ${when(incremental() && helpers.hasFilesForTag("prestaff"), `AND file_name IN (${helpers.getFileNamesSqlList("prestaff")})`)}
  ${when(incremental() && !helpers.hasFilesForTag("prestaff"), `AND FALSE`)}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY id_registro, fecha_operacion 
  ORDER BY fecha_hora_pesaje DESC, _dw_loaded_at DESC
) = 1
