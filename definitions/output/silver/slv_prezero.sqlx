config {
  type: "incremental",
  schema: constants.SCHEMAS.SILVER,
  tags: ["prezero", "silver"],
  description: "Capa Silver: Registros de PreZero limpios, deduplicados y con surrogate key determinista (Histórico)",
  bigquery: {
    clusterBy: ["file_name"]
  },
  columns: {
    prezero_sk: "Surrogate Key determinista SHA256 (id_registro + fecha_operacion)",
    id_registro: "Identificador del registro de pesaje",
    centro_operativo: "Centro o planta operativa estandarizada",
    tipo_residuo: "Tipología de material estandarizada",
    peso_neto_kg: "Peso neto en kilogramos verificado",
    fecha_operacion: "Fecha de la operación",
    fecha_hora_pesaje: "Timestamp del pesaje",
    file_id: docs.columns.file_id,
    file_name: docs.columns.file_name,
    _source_file_id: docs.columns._source_file_id,
    _source_file_name: docs.columns._source_file_name,
    _dw_loaded_at: docs.columns._dw_loaded_at,
    _dw_loaded_by: docs.columns._dw_loaded_by
  },
  assertions: {
    uniqueKey: ["prezero_sk"],
    nonNull: ["prezero_sk", "id_registro"]
  }
}

pre_operations {
  ${when(incremental(), `
    ALTER TABLE ${self()}
    ADD COLUMN IF NOT EXISTS file_id STRING,
    ADD COLUMN IF NOT EXISTS file_name STRING,
    ADD COLUMN IF NOT EXISTS _source_file_id STRING,
    ADD COLUMN IF NOT EXISTS _source_file_name STRING;
  `)}
  ${when(incremental() && helpers.hasFilesForTag("prezero"),
    `DELETE FROM ${self()} WHERE file_name IN (${helpers.getFileNamesSqlList("prezero")});`,
    `SELECT 1;`
  )}
}

SELECT
  ${helpers.surrogateKey(["id_registro", "fecha_operacion"])} AS prezero_sk,
  id_registro,
  centro_operativo,
  tipo_residuo,
  COALESCE(peso_neto_kg, 0) AS peso_neto_kg,
  fecha_operacion,
  fecha_hora_pesaje,
  file_id,
  file_name,
  _source_file_id,
  _source_file_name,
  CURRENT_TIMESTAMP() AS _dw_loaded_at,
  SESSION_USER() AS _dw_loaded_by
FROM
  ${ref("brz_prezero")}
${when(incremental() && helpers.hasFilesForTag("prezero"), `WHERE file_name IN (${helpers.getFileNamesSqlList("prezero")})`)}
${when(incremental() && !helpers.hasFilesForTag("prezero"), `WHERE FALSE`)}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY id_registro, fecha_operacion 
  ORDER BY fecha_hora_pesaje DESC, _dw_loaded_at DESC
) = 1
